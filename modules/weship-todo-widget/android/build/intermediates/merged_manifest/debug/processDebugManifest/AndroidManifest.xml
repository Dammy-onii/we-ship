<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.weship.todowidget" >

    <uses-sdk android:minSdkVersion="24" />

    <application>
        <receiver
            android:name="app.weship.todowidget.TopTodoWidgetProvider"
            android:exported="true"
            android:label="@string/weship_todo_widget_name" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weship_todo_widget_info" />
        </receiver>
        <receiver
            android:name="app.weship.todowidget.PartnerCarouselProvider"
            android:exported="true"
            android:label="@string/weship_partner_widget_name" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weship_partner_carousel_info" />
        </receiver>
        <receiver
            android:name="app.weship.todowidget.FriendsCarouselProvider"
            android:exported="true"
            android:label="@string/weship_friends_widget_name" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weship_friends_carousel_info" />
        </receiver>
        <receiver
            android:name="app.weship.todowidget.PresenceWidgetProvider"
            android:exported="true"
            android:label="@string/weship_presence_widget_name" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weship_presence_info" />
        </receiver>
        <receiver
            android:name="app.weship.todowidget.QuickSendWidgetProvider"
            android:exported="true"
            android:label="@string/weship_quick_widget_name" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weship_quick_send_info" />
        </receiver>

        <!-- Widget button taps. Not exported: only this app may trigger them. -->
        <receiver
            android:name="app.weship.todowidget.WidgetActionReceiver"
            android:exported="false" />

        <!--
         Feeds the swipeable StackView carousels. The permission is required by
         the platform so only the launcher may bind to it.
        -->
        <service
            android:name="app.weship.todowidget.CarouselRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Feeds the scrollable 2do list. -->
        <service
            android:name="app.weship.todowidget.TodoListRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>

</manifest>