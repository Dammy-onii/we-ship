<?xml version="1.0" encoding="utf-8"?>
<!--
  One slide, filling the whole widget.

  The source label used to be painted on the widget root, above the stack, which
  put "WESHIP FRIENDS" on a strip of bare card above the photo. It now rides in
  the slide's own scrim so the image runs edge to edge.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/weship_slide_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/weship_widget_background"
  android:clipToOutline="true">

  <ImageView
    android:id="@+id/weship_slide_image"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:adjustViewBounds="false"
    android:contentDescription="@string/weship_carousel_image" />

  <TextView
    android:id="@+id/weship_slide_note"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="20dp"
    android:maxLines="7"
    android:ellipsize="end"
    android:lineSpacingMultiplier="1.25"
    android:textSize="16sp"
    android:textColor="@color/weship_widget_text"
    android:visibility="gone" />

  <TextView
    android:id="@+id/weship_slide_source"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:layout_margin="10dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:background="@drawable/weship_widget_chip"
    android:textSize="9sp"
    android:textStyle="bold"
    android:letterSpacing="0.08"
    android:textColor="@color/weship_widget_on_scrim" />

  <ImageView
    android:id="@+id/weship_slide_play"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:layout_gravity="top|end"
    android:layout_margin="10dp"
    android:src="@drawable/weship_widget_open_circle"
    android:visibility="gone"
    android:contentDescription="@string/weship_carousel_video" />

  <LinearLayout
    android:id="@+id/weship_slide_track"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@color/weship_widget_scrim"
    android:paddingStart="14dp"
    android:paddingEnd="56dp"
    android:paddingTop="9dp"
    android:paddingBottom="12dp">

    <TextView
      android:id="@+id/weship_slide_caption"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="2"
      android:ellipsize="end"
      android:textSize="12sp"
      android:textColor="@color/weship_widget_on_scrim"
      android:visibility="gone" />

    <TextView
      android:id="@+id/weship_slide_author"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="10sp"
      android:textStyle="bold"
      android:letterSpacing="0.06"
      android:textColor="@color/weship_widget_on_scrim" />
  </LinearLayout>
</FrameLayout>
