<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/weship_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/weship_widget_background"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/weship_widget_status"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="@string/weship_todo_widget_status"
      android:src="@drawable/weship_widget_open_circle" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:fontFamily="sans-serif-medium"
      android:letterSpacing="0.08"
      android:text="@string/weship_todo_widget_label"
      android:textColor="@color/weship_widget_secondary"
      android:textSize="11sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/weship_widget_task"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="9dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:fontFamily="sans-serif-medium"
    android:gravity="bottom"
    android:maxLines="2"
    android:text="@string/weship_todo_widget_empty"
    android:textColor="@color/weship_widget_text"
    android:textSize="19sp" />

  <TextView
    android:id="@+id/weship_widget_routine"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:fontFamily="sans-serif-medium"
    android:text="@string/weship_todo_widget_open"
    android:textColor="@color/weship_widget_secondary"
    android:textSize="11sp" />
</LinearLayout>

