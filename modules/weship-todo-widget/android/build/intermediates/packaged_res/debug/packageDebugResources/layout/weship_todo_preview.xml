<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview for the 2do widget.

  The real layout draws its rows from a RemoteViews collection, which the picker
  does not bind — so previewing it directly showed an empty card reading "All
  caught up", which is not what the widget is for.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/weship_widget_background"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingEnd="16dp"
  android:paddingTop="14dp"
  android:paddingBottom="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <TextView
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:letterSpacing="0.08"
      android:text="@string/weship_todo_widget_label"
      android:textColor="@color/weship_widget_secondary"
      android:textSize="11sp" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:text="@string/weship_preview_progress"
      android:textColor="@color/weship_widget_accent"
      android:textSize="11sp" />
  </LinearLayout>

  <include layout="@layout/weship_todo_preview_row" />
  <include layout="@layout/weship_todo_preview_row" />
</LinearLayout>
