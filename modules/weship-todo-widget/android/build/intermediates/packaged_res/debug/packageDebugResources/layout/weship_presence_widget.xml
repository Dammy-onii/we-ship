<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/weship_presence_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:padding="14dp"
  android:background="@drawable/weship_widget_background">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/weship_presence_name"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="18sp"
      android:textStyle="bold"
      android:textColor="@color/weship_widget_text" />

    <!-- Carried here when the standalone streak widget was retired. -->
    <TextView
      android:id="@+id/weship_presence_streak"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:maxLines="1"
      android:textSize="11sp"
      android:textStyle="bold"
      android:textColor="@color/weship_widget_secondary" />
  </LinearLayout>

  <TextView
    android:id="@+id/weship_presence_mood"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:maxLines="2"
    android:ellipsize="end"
    android:textSize="14sp"
    android:textColor="@color/weship_widget_text" />

  <TextView
    android:id="@+id/weship_presence_task"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textSize="12sp"
    android:textColor="@color/weship_widget_text" />

  <TextView
    android:id="@+id/weship_presence_meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:maxLines="1"
    android:textSize="11sp"
    android:textStyle="bold"
    android:textColor="@color/weship_widget_secondary" />
</LinearLayout>
