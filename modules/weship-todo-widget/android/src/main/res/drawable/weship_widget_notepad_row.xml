<?xml version="1.0" encoding="utf-8"?>
<!--
  One ruled line of the 2do pad.

  The list scrolls, so the rules have to scroll with it — a fixed ladder behind
  a moving ListView would slide out from under its own rows. Each row therefore
  carries its own bottom rule, which is what a real pad looks like anyway.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@android:color/transparent" />
    </shape>
  </item>

  <item
    android:height="1dp"
    android:gravity="bottom|fill_horizontal">
    <shape android:shape="rectangle">
      <solid android:color="@color/weship_widget_line" />
    </shape>
  </item>
</layer-list>
