<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget picker preview. Self-contained on purpose.

  These files previously held a one-line <include> pointing at the real layout.
  The launcher resolves a preview in its own process, and the indirection did
  not survive the crossing: the picker rendered the WRONG widget's preview —
  Friends showed Quick send, Presence showed 2do — and Quick send failed
  outright with "Couldn't add widget". The `_v2` name is what busts a launcher's
  cached preview id after an update; the wrapper never needed to exist.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@drawable/weship_widget_background">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:src="@drawable/weship_icon_send"
      android:contentDescription="@string/weship_quick_open_composer" />

    <TextView
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="@string/weship_quick_preview_label"
      android:textSize="11sp"
      android:textStyle="bold"
      android:textColor="@color/weship_widget_text" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:letterSpacing="0.06"
      android:text="@string/weship_quick_open_composer"
      android:textSize="8sp"
      android:textStyle="bold"
      android:textColor="@color/weship_widget_secondary" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="9dp"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:gravity="center"
      android:padding="7dp"
      android:background="@drawable/weship_quick_photo_button">
      <ImageView
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:src="@drawable/weship_icon_camera"
        android:contentDescription="@string/weship_quick_photo" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/weship_quick_photo"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_text" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/weship_quick_photo_hint"
        android:textSize="9sp"
        android:textColor="@color/weship_widget_secondary" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="match_parent"
      android:layout_marginStart="8dp"
      android:orientation="vertical"
      android:gravity="center"
      android:padding="7dp"
      android:background="@drawable/weship_quick_voice_button">
      <ImageView
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:src="@drawable/weship_icon_mic"
        android:contentDescription="@string/weship_quick_voice" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/weship_quick_voice"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_text" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/weship_quick_voice_hint"
        android:textSize="9sp"
        android:textColor="@color/weship_widget_secondary" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="match_parent"
      android:layout_marginStart="8dp"
      android:orientation="vertical"
      android:gravity="center"
      android:padding="7dp"
      android:background="@drawable/weship_quick_note_button">
      <ImageView
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:src="@drawable/weship_icon_note"
        android:contentDescription="@string/weship_quick_note" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/weship_quick_note"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_text" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/weship_quick_note_hint"
        android:textSize="9sp"
        android:textColor="@color/weship_widget_secondary" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
