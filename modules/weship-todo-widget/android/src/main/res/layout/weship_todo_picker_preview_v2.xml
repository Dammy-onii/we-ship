<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget picker preview. Self-contained on purpose.

  These files previously held a one-line <include> pointing at the real layout.
  The launcher resolves a preview in its own process, and the indirection did
  not survive the crossing: the picker rendered the WRONG widget's preview —
  Friends showed Quick send, Presence showed 2do — and Quick send failed
  outright with "Couldn't add widget". The `_v2` name is what busts a launcher's
  cached preview id after an update; the wrapper never needed to exist.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/weship_widget_background"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingEnd="16dp"
  android:paddingTop="12dp"
  android:paddingBottom="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <TextView
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:letterSpacing="0.08"
      android:text="@string/weship_todo_widget_label"
      android:textColor="@color/weship_widget_secondary"
      android:textSize="11sp" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:text="@string/weship_preview_progress"
      android:textColor="@color/weship_widget_accent"
      android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:baselineAligned="false">

    <ImageView
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:src="@drawable/weship_widget_open_circle"
      android:contentDescription="@string/weship_todo_widget_status" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:text="@string/weship_preview_task"
        android:textColor="@color/weship_widget_text"
        android:textSize="13sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="@string/weship_preview_routine"
        android:textColor="@color/weship_widget_secondary"
        android:textSize="8sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:baselineAligned="false">

    <ImageView
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:src="@drawable/weship_widget_open_circle"
      android:contentDescription="@string/weship_todo_widget_status" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:text="@string/weship_preview_task"
        android:textColor="@color/weship_widget_text"
        android:textSize="13sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="@string/weship_preview_routine"
        android:textColor="@color/weship_widget_secondary"
        android:textSize="8sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:baselineAligned="false">

    <ImageView
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:src="@drawable/weship_widget_open_circle"
      android:contentDescription="@string/weship_todo_widget_status" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:text="@string/weship_preview_task"
        android:textColor="@color/weship_widget_text"
        android:textSize="13sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="@string/weship_preview_routine"
        android:textColor="@color/weship_widget_secondary"
        android:textSize="8sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:baselineAligned="false">

    <ImageView
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:src="@drawable/weship_widget_open_circle"
      android:contentDescription="@string/weship_todo_widget_status" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:text="@string/weship_preview_task"
        android:textColor="@color/weship_widget_text"
        android:textSize="13sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="@string/weship_preview_routine"
        android:textColor="@color/weship_widget_secondary"
        android:textSize="8sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
