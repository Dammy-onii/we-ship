<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/weship_carousel_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/weship_widget_background">

  <StackView
    android:id="@+id/weship_carousel_stack"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:loopViews="true"
    android:autoStart="true" />

  <TextView
    android:id="@+id/weship_carousel_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="16dp"
    android:textSize="13sp"
    android:textColor="@color/weship_widget_secondary" />

  <TextView
    android:id="@+id/weship_carousel_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:textSize="10sp"
    android:textStyle="bold"
    android:textColor="@color/weship_widget_secondary" />
</FrameLayout>
