<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately has no background of its own.

  The widget root and every slide both painted the same rounded card, so the
  card was drawn twice and the photo appeared to float in a white frame instead
  of filling the widget. AdapterViewFlipper keeps exactly one flat slide visible.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/weship_carousel_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <!-- flipInterval was fifteen minutes, which reads as "never moves" to anyone
       actually looking at it. Half a minute is slow enough to ignore and fast
       enough to notice. -->
  <AdapterViewFlipper
    android:id="@+id/weship_carousel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:animateFirstView="false"
    android:flipInterval="30000"
    android:loopViews="true" />

  <!--
    Empty state, drawn as a slide rather than as a message on a blank card.

    The widget's whole job is to show a picture, so an empty one should still
    look like the thing it will become — the same landscape the app's Spotlight
    shows when nothing has been shared, with the message riding in the scrim
    exactly where a real caption would.
  -->
  <!--
    Never normally seen: the adapter substitutes two placeholder slides when
    there is nothing to show, so the collection is never empty. Kept only as the
    fallback for the moment before the factory has bound.
  -->
  <TextView
    android:id="@+id/weship_carousel_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="18dp"
    android:background="@drawable/weship_widget_background"
    android:textSize="13sp"
    android:textColor="@color/weship_widget_secondary" />

  <!--
    Arrows sit on the widget root rather than inside the collection: a view inside a
    RemoteViews collection can only carry a fill-in intent, so it cannot run an
    action of its own.
  -->
  <LinearLayout
    android:id="@+id/weship_carousel_controls"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/weship_carousel_counter"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:textSize="10sp"
      android:textStyle="bold"
      android:textColor="@color/weship_widget_on_scrim" />

    <ImageView
      android:id="@+id/weship_carousel_previous"
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:padding="5dp"
      android:background="@drawable/weship_widget_control"
      android:src="@drawable/weship_icon_chevron_left"
      android:contentDescription="@string/weship_carousel_previous" />

    <ImageView
      android:id="@+id/weship_carousel_next"
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:layout_marginStart="6dp"
      android:padding="5dp"
      android:background="@drawable/weship_widget_control"
      android:src="@drawable/weship_icon_chevron_right"
      android:contentDescription="@string/weship_carousel_next" />
  </LinearLayout>
</FrameLayout>
