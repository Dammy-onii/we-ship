<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/weship_quick_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:padding="14dp"
  android:background="@drawable/weship_widget_background">

  <TextView
    android:id="@+id/weship_quick_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="end"
    android:textSize="11sp"
    android:textStyle="bold"
    android:textColor="@color/weship_widget_secondary" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <LinearLayout
      android:id="@+id/weship_quick_photo"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:gravity="center"
      android:paddingTop="12dp"
      android:paddingBottom="12dp"
      android:background="@drawable/weship_widget_button">
      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/weship_icon_camera"
        android:contentDescription="@string/weship_quick_photo" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/weship_quick_photo"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_secondary" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/weship_quick_voice"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:orientation="vertical"
      android:gravity="center"
      android:paddingTop="12dp"
      android:paddingBottom="12dp"
      android:background="@drawable/weship_widget_button">
      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/weship_icon_mic"
        android:contentDescription="@string/weship_quick_voice" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/weship_quick_voice"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_secondary" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/weship_quick_note"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:orientation="vertical"
      android:gravity="center"
      android:paddingTop="12dp"
      android:paddingBottom="12dp"
      android:background="@drawable/weship_widget_button">
      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/weship_icon_note"
        android:contentDescription="@string/weship_quick_note" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/weship_quick_note"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_secondary" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
