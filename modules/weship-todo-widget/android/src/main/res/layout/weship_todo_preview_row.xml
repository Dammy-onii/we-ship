<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:paddingTop="9dp"
  android:paddingBottom="9dp"
  android:baselineAligned="false">

  <ImageView
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:src="@drawable/weship_widget_open_circle"
    android:contentDescription="@string/weship_todo_widget_status" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:orientation="vertical">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:text="@string/weship_preview_task"
      android:textColor="@color/weship_widget_text"
      android:textSize="15sp" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:letterSpacing="0.06"
      android:text="@string/weship_preview_routine"
      android:textColor="@color/weship_widget_secondary"
      android:textSize="10sp" />
  </LinearLayout>
</LinearLayout>
