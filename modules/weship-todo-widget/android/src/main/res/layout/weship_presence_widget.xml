<?xml version="1.0" encoding="utf-8"?>
<!-- A compact relationship dashboard: identity, status, context and one action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/weship_presence_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@drawable/weship_widget_background">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <TextView
      android:id="@+id/weship_presence_emoji"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:gravity="center"
      android:background="@drawable/weship_widget_mood_badge"
      android:text="@string/weship_presence_preview_emoji"
      android:textSize="20sp" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:orientation="vertical">

      <TextView
        android:id="@+id/weship_presence_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/weship_presence_preview_name"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_text" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/weship_presence_right_now"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_accent" />
    </LinearLayout>

    <TextView
      android:id="@+id/weship_presence_streak"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:paddingStart="9dp"
      android:paddingEnd="9dp"
      android:paddingTop="5dp"
      android:paddingBottom="5dp"
      android:background="@drawable/weship_widget_streak"
      android:text="@string/weship_presence_preview_streak"
      android:maxLines="1"
      android:textSize="11sp"
      android:textStyle="bold"
      android:textColor="@color/weship_widget_on_scrim" />
  </LinearLayout>

  <!--
    Hugs its text. This panel used to carry the layout weight, so it absorbed
    every spare pixel and a one-word mood sat in the middle of a large empty
    box. The spacer below takes the slack instead, which keeps the footer
    pinned to the bottom without inflating the panel.
  -->
  <TextView
    android:id="@+id/weship_presence_mood"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/weship_widget_panel"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:maxLines="3"
    android:ellipsize="end"
    android:text="@string/weship_presence_preview_status"
    android:textSize="14sp"
    android:textColor="@color/weship_widget_text" />

  <!-- FrameLayout, not Space: RemoteViews only inflates an allow-listed set
       of view classes and Space is not one of them. -->
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <LinearLayout
    android:id="@+id/weship_presence_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <TextView
        android:id="@+id/weship_presence_meta_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/weship_presence_their_time"
        android:letterSpacing="0.06"
        android:textSize="8sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_secondary" />

      <TextView
        android:id="@+id/weship_presence_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/weship_presence_preview_time"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_text" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:orientation="vertical">

      <TextView
        android:id="@+id/weship_presence_detail_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/weship_presence_next_todo"
        android:letterSpacing="0.06"
        android:textSize="8sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_secondary" />

      <TextView
        android:id="@+id/weship_presence_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/weship_presence_preview_task"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/weship_widget_text" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
