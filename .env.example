# Public values embedded in the Expo app. Do not put Google secrets or the
# Supabase service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
EXPO_PUBLIC_EAS_PROJECT_ID=REPLACE_ME

# Stable native application identifiers used by local scripts/EAS profiles.
IOS_BUNDLE_IDENTIFIER=app.weship.mobile
ANDROID_PACKAGE=app.weship.mobile
