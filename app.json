{
  "expo": {
    "name": "Weship",
    "slug": "we-ship",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/generated/icon.png",
    "scheme": "weship",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.weship.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "app.weship.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EE",
        "foregroundImage": "./assets/images/generated/android-icon-foreground.png",
        "monochromeImage": "./assets/images/generated/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/generated/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/generated/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EE"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": true
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Weship to use the camera for Scene Challenges.",
          "microphonePermission": "Allow Weship to record sound during Scene Challenges.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Weship to record voice notes for your partner."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Weship to choose photos and videos for shared Goodies and Memories.",
          "cameraPermission": "Allow Weship to use the camera when you take a photo or video to share.",
          "microphonePermission": "Allow Weship to record sound when you take a video to share."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/generated/android-icon-monochrome.png",
          "color": "#5F5B57",
          "defaultChannel": "weship-updates-v4"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TopTodoWidget",
              "displayName": "Weship 2do",
              "description": "Up to four shared 2dos at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": true,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              },
              "android": null
            },
            {
              "name": "PartnerCarouselWidget",
              "displayName": "Weship Us",
              "description": "Photos, videos and notes you have shared.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ],
              "contentMarginsDisabled": true,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              },
              "android": null
            },
            {
              "name": "FriendsCarouselWidget",
              "displayName": "Weship Friends",
              "description": "What your friends have posted.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ],
              "contentMarginsDisabled": true,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              },
              "android": null
            },
            {
              "name": "PresenceWidget",
              "displayName": "Weship Presence",
              "description": "Your partner's mood and their time.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": true,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true
              },
              "android": null
            },
            {
              "name": "QuickSendWidget",
              "displayName": "Weship Quick send",
              "description": "Send a photo, voice note or note in one tap.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": true,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              },
              "android": null
            }
          ]
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": true,
        "style": "light"
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "app.weship.mobile.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.weship.mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "2002b1cd-7490-4b13-89b6-8979b531f093"
      }
    },
    "owner": "damilolaoni"
  }
}
